# Root gitignore for Muhafiz parent folder

# ── Node.js ────────────────────────────────────────────────────────────
**/node_modules/
node_modules/

# ── WhatsApp session / auth data ───────────────────────────────────────
**/.wwebjs_auth/
**/.wwebjs_cache/
**/auth_session/

# ── Flutter / Dart ─────────────────────────────────────────────────────
**/build/
**/.dart_tool/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/.pub-cache/
**/.pub/
**/coverage/

# ── Android secrets ────────────────────────────────────────────────────
**/android/app/google-services.json
**/android/local.properties
**/android/key.properties
**/*.keystore
**/*.jks
**/.gradle/
**/local.properties

# ── iOS secrets ────────────────────────────────────────────────────────
**/ios/GoogleService-Info.plist
**/ios/Runner/GoogleService-Info.plist
**/ios/Flutter/flutter_export_environment.sh

# ── Firebase (all platforms) ───────────────────────────────────────────
**/google-services.json
**/GoogleService-Info.plist
**/firebase_app_id_file.json

# ── IDE & editor ───────────────────────────────────────────────────────
**/.idea/
**/*.iml
**/*.ipr
**/*.iws
**/.vscode/settings.json

# ── Environment files (secrets) ────────────────────────────────────────
**/.env
**/.env.local
**/.env.production
**/.env.development

# ── Crash logs & generated files ───────────────────────────────────────
*.log
hs_err_pid*.log

# ── OS files ───────────────────────────────────────────────────────────
**/.DS_Store
Thumbs.db
Desktop.ini
