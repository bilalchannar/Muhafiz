# WhatsApp Bot — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit the actual .env file.

# Port the bot server will listen on
PORT=3001

# (Optional) Path where WhatsApp session files are stored locally
# Defaults to ./auth_session inside the project directory
SESSION_PATH=./auth_session

# (Linux/Docker only) Full path to the Chromium/Chrome binary used by Puppeteer
# Not needed on Windows (uses the system Chrome installation automatically)
# Example for Linux: /usr/bin/chromium-browser
# Example for Docker: /usr/bin/google-chrome
PUPPETEER_EXECUTABLE_PATH=
